#BMI Categories:
weight = float(input('Enter your weight(kg)'))
height = float(input('Enter your height(m)'))
BMI = weight/height **2
print("Your BMI = ",BMI)
if BMI < 18.5:
    print("Underweight")
elif BMI >18.5 and BMI <=24.9:
    print("Normal weight")
elif BMI > 25 and BMI <= 29.9:
    print("Overweight")
else :
    print("Obese")
