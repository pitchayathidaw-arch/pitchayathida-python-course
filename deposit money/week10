def deposit(money):
    balance = 1000
    print("ยอดเงินเริ่มต้น:", balance, "บาท")
    
    try:
        # รับค่าจากผู้ใช้และแปลงเป็นทศนิยม
        deposit_amount = float(input("กรอกจำนวนเงินที่ต้องการฝาก: "))
        
        # ตรวจสอบหากจำนวนเงินน้อยกว่าหรือเท่ากับ 0
        if deposit_amount <= 0:
            raise ValueError("จำนวนเงินฝากต้องมากกว่า 0")
            
    except ValueError as e:
        # ดักจับข้อผิดพลาด (รวมถึง ValueError ที่ raise ขึ้นมาเอง)
        print("เกิดข้อผิดพลาด:", e)
        
    else:
        # ทำงานเมื่อไม่มีข้อผิดพลาดเกิดขึ้น
        balance += deposit_amount
        print("\nฝากเงินสำเร็จ")
        print("ยอดเงินคงเหลือ: {:.2f} บาท".format(balance))
        
    finally:
        # ทำงานทุกครั้งไม่ว่าจะเกิดข้อผิดพลาดหรือไม่ก็ตาม
        print("สิ้นสุดรายการฝากเงิน")

# ทดลองเรียกใช้งานฟังก์ชัน
deposit(0)